# Plantilla de application-local.properties.
# Copiá este archivo como "application-local.properties" (sin .example) en la misma carpeta
# y completá los valores reales. Ese archivo no se versiona.

spring.datasource.username=root
spring.datasource.password=TU_PASSWORD_MYSQL

cloudinary.api_key=TU_CLOUDINARY_API_KEY
cloudinary.api_secret=TU_CLOUDINARY_API_SECRET

# Generar con: openssl rand -base64 48
api.security.secret=GENERAR_UN_SECRET_ALEATORIO_LARGO

# Panel: developers.mercadopago.com > Tus integraciones > tu app > Credenciales de PRUEBA
mercadopago.access-token=TEST-TU_ACCESS_TOKEN
# Panel de la app > Webhooks > Firma secreta
mercadopago.webhook-secret=TU_FIRMA_SECRETA
# URL pública (ngrok) + /webhooks/mercadopago, ej: https://abcd-1234.ngrok-free.app/webhooks/mercadopago

# Google Cloud Console > APIs & Services > Credentials > tu "OAuth 2.0 Client ID" (tipo Web).
# No hace falta el Client Secret: el backend solo verifica el idToken que ya generó el frontend.
google.oauth.client-id=TU_CLIENT_ID.apps.googleusercontent.com

# Firebase (login/recuperación de contraseña): además de este archivo, hace falta
# colocar el JSON de la cuenta de servicio en src/main/resources/firebase-service-account.json
# (Firebase Console > Configuración del proyecto > Cuentas de servicio > Generar nueva clave
# privada). Tampoco se versiona; a diferencia de Mercado Pago/Google, sin ese archivo la
# aplicación entera no arranca (fail-fast), porque el registro de clientes depende de él.
